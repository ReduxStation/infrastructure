tgs.owo.fm {
    reverse_proxy tgs:5000
}

stats.owo.fm {
    root * /var/www/html/public

    php_fastcgi statbus:9000
    file_server
}

logs.owo.fm {
    root * /srv/logs/logs

    # Defence-in-depth path whitelist. Only requests that match the canonical
    # log layout (`/`, `/YYYY`, `/YYYY/MM`, `/YYYY/MM/DD`, `/YYYY/MM/DD/round-N`,
    # or `/YYYY/MM/DD/round-N/<filename>`) reach the parser or file_server.
    # Anything else (probes for `/admin.php`, `/.env`, traversal, random
    # paths) gets an explicit 404 before any file system access.
    @log_path path_regexp ^(/|/[0-9]{4}(/|/[0-9]{2}(/|/[0-9]{2}(/|/round-[0-9]+(/|/[A-Za-z0-9._-]+)?)?)?)?)?$
    @file_exists file

    handle @log_path {
        # File requests go through the public-log-parser service which scrubs
        # IPs, CIDs, and admin-private content, 404s files in rounds that are
        # still in progress, and gates the per-file allowlist (sql.log,
        # hrefs.log, etc. 404 by name).
        handle @file_exists {
            reverse_proxy log-parser:8090
        }
        # Directory requests (year/month/day/round-N tree plus /) are served
        # straight from the volume by Caddy's file_server browse so users get
        # the built-in directory UI rather than the parser's stub HTML.
        handle {
            file_server browse
        }
    }

    # Anything that did not match the whitelist.
    handle {
        respond 404
    }

    # Allow the demo viewer (demo.owo.fm) to fetch demo.log files cross-origin.
    header Access-Control-Allow-Origin "*"
}

# Internal-only site that serves the public-log-parser's serverinfo.json
# from the game_data volume. The TGS RoundStart/RoundEnd event scripts
# (installed in Configuration/EventScripts/, see tools/tgs4_scripts/) write
# this file with the active round id; the parser polls every 60 seconds
# and 404s any /YYYY/MM/DD/round-N/ path whose round_id is currently in
# the file. Bound to the docker network only, no public binding.
:8081 {
    root * /srv/logs
    file_server
}

demo.owo.fm {
    root * /srv/demo-viewer
    file_server
    header Access-Control-Allow-Origin "*"
}

# Raw map tile pyramid (PNGs). Consumed by webmap.owo.fm and statbus.
tiles.owo.fm {
    root * /srv/tiles

    # Tiles are immutable once rendered — browsers can cache for a week.
    header Cache-Control "public, max-age=604800, immutable"

    # Allow cross-origin requests so webmap.owo.fm and stats.owo.fm can
    # load tiles from a different origin.
    header Access-Control-Allow-Origin "*"

    file_server

    # Return a friendly 404 for missing tiles rather than a Caddy error page.
    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }
}

# Interactive map viewer — Leaflet UI on top of tiles.owo.fm with hover-to-
# examine, click-to-pin, search, and category layer filters.
webmap.owo.fm {
    root * /srv/webmap-site
    file_server
    try_files {path} /index.html

    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }
}
