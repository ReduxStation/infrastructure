# Landing site. Built from https://github.com/ReduxStation/website by the
# website-builder one-shot service; output lands in the website_dist volume
# which is mounted here read-only.
reduxstation.com, www.reduxstation.com {
    root * /srv/website
    file_server
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        ?Cache-Control "public, max-age=300"
    }

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
}

# BYOND join redirect. A browser hitting https://play.reduxstation.com bounces
# straight to byond://reduxstation.com:1337, which the BYOND client URL
# scheme handler intercepts. Caddy obtains a real LE cert for play. so the
# redirect doesn't trip browser HTTPS warnings on the way.
play.reduxstation.com {
    redir byond://reduxstation.com:1337 permanent
}

tgs.reduxstation.com {
    reverse_proxy tgs:5000
}

stats.reduxstation.com {
    root * /var/www/html/public

    php_fastcgi statbus:9000
    file_server
}

logs.reduxstation.com {
    root * /srv/logs/logs

    # Defence-in-depth path whitelist. Only requests that match the canonical
    # log layout (`/`, `/YYYY`, `/YYYY/MM`, `/YYYY/MM/DD`, `/YYYY/MM/DD/round-N`,
    # or `/YYYY/MM/DD/round-N/<filename>`) reach the parser. Anything else
    # (probes for `/admin.php`, `/.env`, traversal, random paths) gets an
    # explicit 404 before any file system access.
    @log_path path_regexp ^(/|/[0-9]{4}(/|/[0-9]{2}(/|/[0-9]{2}(/|/round-[0-9]+(/|/[A-Za-z0-9._-]+)?)?)?)?)?$

    # Every whitelisted path goes through the public-log-parser, INCLUDING
    # day-level browse pages (`/YYYY/MM/DD/`). The parser:
    #   * renders directory listings filtered to exclude in-progress rounds
    #     (collect_traversal_items skips entries that path_is_ongoing_round
    #     reports true for, so round-N dirs do not appear in the day listing
    #     while they are running)
    #   * scrubs IPs/CIDs/ADMINPRIVATE for files
    #   * 404s any path under an in-progress round
    #   * gates the per-file allowlist (sql.log, hrefs.log, etc. 404 by name)
    # Earlier this site routed day-level dirs to Caddy's `file_server browse`,
    # which listed every round-N entry on disk regardless of in-progress
    # state - the round content was 404d on click, but the LISTING leaked the
    # existence of the in-progress round. Routing day paths through the
    # parser is what closes that leak.
    handle @log_path {
        reverse_proxy log-parser:8090
    }

    # Anything that did not match the whitelist.
    handle {
        respond 404
    }

    # Allow the demo viewer (demo.reduxstation.com) to fetch demo.log files cross-origin.
    header Access-Control-Allow-Origin "*"
}

# Internal-only site that serves the public-log-parser's serverinfo.json
# from the game_data volume. The TGS RoundStart/RoundEnd event scripts
# (wrappers installed in Configuration/EventScripts/ forward to
# tools/tgs_scripts/RoundStart.sh and RoundEnd.sh) write this file with the
# active round id; the parser polls every 60 seconds and 404s any
# /YYYY/MM/DD/round-N/ path whose round_id is currently in the file. Bound
# to the docker network only, no public binding.
:8081 {
    root * /srv/logs
    file_server
}

demo.reduxstation.com {
    root * /srv/demo-viewer
    file_server
    header Access-Control-Allow-Origin "*"
}

# BYOND RSC asset CDN. Serves the compiled .rsc files from the live game
# directory so BYOND clients can preload resources over HTTPS instead of
# through the in-band BYOND TCP socket. Wired by /client/proc/send_resources
# which sets client.preload_rsc from config/external_rsc_urls.txt.
# Only *.rsc paths are served; everything else 404s so the rest of the TGS
# game directory is not exposed.
rsc.reduxstation.com {
    root * /srv/tgs/ReduxStation/Game/Live

    @rsc path *.rsc
    handle @rsc {
        encode gzip
        header Cache-Control "public, max-age=300"
        header Access-Control-Allow-Origin "*"
        file_server
    }
    handle {
        respond 404
    }
}

# Raw map tile pyramid (PNGs). Consumed by map.reduxstation.com and statbus.
tiles.reduxstation.com {
    root * /srv/tiles

    # Tiles are immutable once rendered — browsers can cache for a week.
    header Cache-Control "public, max-age=604800, immutable"

    # Allow cross-origin requests so map.reduxstation.com and stats.reduxstation.com can
    # load tiles from a different origin.
    header Access-Control-Allow-Origin "*"

    file_server

    # Return a friendly 404 for missing tiles rather than a Caddy error page.
    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }
}

# Interactive map viewer — Leaflet UI on top of tiles.reduxstation.com with hover-to-
# examine, click-to-pin, search, and category layer filters.
map.reduxstation.com {
    root * /srv/webmap-site
    file_server
    try_files {path} /index.html

    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }
}

# Server-local site definitions (e.g. extra hostnames a particular operator
# wants to reverse-proxy alongside the standard ones). Files matching
# /etc/caddy/sites.d/*.caddy are loaded as additional top-level config.
# The directory is created in the caddy image so this import is always safe;
# if no override files are mounted in, the glob expands to nothing and Caddy
# happily proceeds with just the canonical sites above.
#
# Operators add server-only sites via docker-compose.override.yml mounting a
# host directory at /etc/caddy/sites.d/ (see docker-compose.override.yml.example).
import /etc/caddy/sites.d/*.caddy
