tgs.owo.fm {
    reverse_proxy tgs:5000
}

stats.owo.fm {
    root * /var/www/html/public

    php_fastcgi statbus:9000
    file_server
}

logs.owo.fm {
    root * /srv/logs/logs

    # File requests (the .log/.json/.html/.txt content of each round) go through
    # the public-log-parser service which scrubs IPs, CIDs, and admin-private
    # content, and 404s files in rounds that are still in progress. The parser
    # also gates the per-file allowlist (sql.log, hrefs.log, etc. 404 by name).
    @file_exists file
    handle @file_exists {
        reverse_proxy log-parser:8090
    }

    # Directory requests (the year/month/day/round-N tree, plus /) are served
    # straight from the volume by Caddy's file_server browse so users get the
    # built-in directory UI rather than the parser's stub HTML.
    handle {
        file_server browse
    }

    # Allow the demo viewer (demo.owo.fm) to fetch demo.log files cross-origin.
    header Access-Control-Allow-Origin "*"
}

# Internal-only site that serves the public-log-parser's serverinfo.json
# from the game_data volume. The TGS RoundStart/RoundEnd event scripts
# (installed in Configuration/EventScripts/, see tools/tgs4_scripts/) write
# this file with the active round id; the parser polls every 60 seconds
# and 404s any /YYYY/MM/DD/round-N/ path whose round_id is currently in
# the file. Bound to the docker network only, no public binding.
:8081 {
    root * /srv/logs
    file_server
}

demo.owo.fm {
    root * /srv/demo-viewer
    file_server
    header Access-Control-Allow-Origin "*"
}

webmap.owo.fm {
    root * /srv/webmap

    # Tiles are immutable once rendered — browsers can cache for a week.
    header Cache-Control "public, max-age=604800, immutable"

    # Allow cross-origin requests so Leaflet can load tiles from a different
    # origin than stats.owo.fm.
    header Access-Control-Allow-Origin "*"

    file_server

    # Return a friendly 404 for missing tiles rather than a Caddy error page.
    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }
}
