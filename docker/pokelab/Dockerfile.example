# Optional PHP-FPM image for site-local PHP applications reverse-proxied
# through the master Caddy. Copy to docker/pokelab/Dockerfile to enable;
# the path matches the dockerfile reference in
# docker-compose.override.yml.example.
#
# Add any extensions your site needs alongside pdo_sqlite below.
FROM php:8.3-fpm-alpine

RUN apk add --no-cache sqlite-dev \
    && docker-php-ext-install pdo pdo_sqlite
