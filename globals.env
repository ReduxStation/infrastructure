# ReduxStation infrastructure globals.
# Sourced by docker-compose (via .env symlink), every EventScript, every deploy script.
# Secrets are NOT here; they live at /etc/redux/secrets/ on the host.
# Host-only secret env-var overrides come from .env.local (gitignored).

PROJECT_NAME=reduxstation
TGS_INSTANCE_NAME=ReduxStation
TGS_INSTANCE_ROOT=/tgs_instances/${TGS_INSTANCE_NAME}
SERVER_SUBDIR=reduxstation
GAME_REPO_URL=https://github.com/ReduxStation/ReduxStation.git
CONFIG_REPO_URL=https://github.com/ReduxStation/config.git
INFRA_REPO_URL=https://github.com/ReduxStation/infrastructure.git
SECRETS_DIR=/etc/redux/secrets
TGS_EVENTSCRIPTS_DIR=/etc/tgs-EventScripts.d/reduxstation
INFRA_CHECKOUT=/srv/redux/infrastructure
GAME_PORT=1337
MARIADB_PORT=3306
STATBUS_APP="ReduxStation Statbus"
GITHUB=ReduxStation/ReduxStation
