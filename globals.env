# ResurgenceStation infrastructure globals.
# Sourced by docker-compose (via .env symlink), every EventScript, every deploy script.
# Secrets are NOT here; they live at /etc/resurgence/secrets/ on the host.
# Host-only secret env-var overrides come from .env.local (gitignored).

PROJECT_NAME=resurgencestation
TGS_INSTANCE_NAME=ResurgenceStation
SERVER_SUBDIR=owo
GAME_REPO_URL=https://github.com/ResurgenceStation/ResurgenceStation.git
CONFIG_REPO_URL=https://github.com/ResurgenceStation/config.git
INFRA_REPO_URL=https://github.com/ResurgenceStation/infrastructure.git
SECRETS_DIR=/etc/resurgence/secrets
TGS_EVENTSCRIPTS_DIR=/etc/tgs-EventScripts.d/resurgencestation
INFRA_CHECKOUT=/srv/resurgence/infrastructure
GAME_PORT=1337
MARIADB_PORT=3306
STATBUS_APP=ResurgenceStation Statbus
GITHUB=ResurgenceStation/ResurgenceStation
