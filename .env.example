# Copy to .env.local on the host. Mode 0600. Contains values from /etc/redux/secrets/.
# Used for env-var-style secret injection where Compose `secrets:` files won't work
# (TGS doesn't support _FILE convention for Database__ConnectionString).
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- MediaWiki (wiki.reduxstation.com) ---
# Consumed only on first start to seed the initial sysop row. Change in-app
# via Special:ChangePassword after first login.
MEDIAWIKI_ADMIN_USER=redux-admin
MEDIAWIKI_ADMIN_PASSWORD=
# $wgSecretKey — signs session cookies and CSRF tokens. Rotation kicks
# everyone out of their session but is otherwise safe.
#   openssl rand -hex 32
MEDIAWIKI_SECRET_KEY=
# $wgUpgradeKey — guards the /mw-config installer endpoint. Per-deploy random.
#   openssl rand -hex 16
MEDIAWIKI_UPGRADE_KEY=
