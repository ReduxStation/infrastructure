# HippieStation Docker environment
# Copy to .env and set strong passwords before running:
#   cp .env.example .env
#
# Generate a password:  openssl rand -hex 32

# ── MariaDB credentials ───────────────────────────────────────────────────────
# Root password (used only during DB init; not needed by the game or statbus)
MYSQL_ROOT_PASSWORD=change_me_root

# Password for the ss13 user (game server + statbus both use this)
MYSQL_PASSWORD=change_me_ss13

# ── Port overrides (optional) ─────────────────────────────────────────────────
# BYOND game port — clients point their BYOND client here
GAME_PORT=1337

# MariaDB host port — useful for local DB tooling; remove in production
MARIADB_PORT=3306

# Statbus web UI port
STATBUS_PORT=8080

# ── Statbus appearance ────────────────────────────────────────────────────────
STATBUS_APP=HippieStation Statbus
GITHUB=HippieStation/HippieStation
