# ResurgenceStation Docker environment
# Copy to .env and fill in real passwords before running:
#   cp .env.example .env
#
# Generate a password:  openssl rand -hex 32

# ── MariaDB credentials ───────────────────────────────────────────────────────
# Root password — used only during first-start DB init
MYSQL_ROOT_PASSWORD=change_me_root

# Password for the ss13 user — used by TGS, statbus, and the game itself
MYSQL_PASSWORD=change_me_ss13

# ── Port overrides (optional) ─────────────────────────────────────────────────
# BYOND game port — clients point their BYOND client here
GAME_PORT=1337

# MariaDB host port — useful for local DB tooling; remove or restrict in production
MARIADB_PORT=3306

# ── Statbus appearance ────────────────────────────────────────────────────────
STATBUS_APP=ResurgenceStation Statbus
GITHUB=ResurgenceStation/ResurgenceStation
